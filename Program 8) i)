# Title: KMeans Clustering on Customer Purchases

from sklearn.cluster import KMeans
import pandas as pd

# Step 1: Load dataset
data = pd.read_csv("D:\\KIOT\\AAAA\\AIML_LAB\\customer_purchases.csv")

# Step 2: Initialize KMeans
kmeans = KMeans(n_clusters=2, random_state=42)

# Step 3: Fit model
kmeans.fit(data)

# Step 4: Predict cluster labels
labels = kmeans.predict(data)
print("KMeans Cluster Labels:", labels)
