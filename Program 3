# Bayesian Network - Heart Disease Prediction

import numpy as np
import pandas as pd
from pgmpy.estimators import MaximumLikelihoodEstimator
from pgmpy.models import BayesianModel
from pgmpy.inference import VariableElimination


def main():
    # Load dataset (make sure heart.csv is in same folder)
    try:
        data = pd.read_csv("heart.csv")
    except FileNotFoundError:
        print("Error: heart.csv not found. Place it in the same folder.")
        return

    # Replace missing values
    data = data.replace("?", np.nan)

    print("Sample instances from the dataset:\n")
    print(data.head())

    print("\nAttributes and Datatypes:\n")
    print(data.dtypes)

    # Define Bayesian Network structure
    model = BayesianModel([
        ('age', 'heartdisease'),
        ('sex', 'heartdisease'),
        ('exang', 'heartdisease'),
        ('cp', 'heartdisease'),   # FIXED typo here
        ('heartdisease', 'restecg'),
        ('heartdisease', 'chol')
    ])

    print("\nLearning CPD using Maximum Likelihood Estimator...")
    model.fit(data, estimator=MaximumLikelihoodEstimator)

    print("\nInferencing with Bayesian Network:")

    infer = VariableElimination(model)

    # Query 1
    print("\n1. Probability of HeartDisease given evidence = restecg")
    q1 = infer.query(variables=['heartdisease'], evidence={'restecg': 1})
    print(q1)

    # Query 2 (from your screenshot)
    print("\n2. Probability of HeartDisease given evidence = cp")
    q2 = infer.query(variables=['heartdisease'], evidence={'cp': 1})
    print(q2)


if __name__ == "__main__":
    main()
