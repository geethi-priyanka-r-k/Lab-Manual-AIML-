# Title: Ensemble Bagging Classifier vs Single KNN on Iris Dataset

# Step 1: Load dataset
from sklearn import datasets
iris = datasets.load_iris()

# Step 2: Split into train and test (using only sepal length & width)
from sklearn.model_selection import train_test_split
X_train, X_test, y_train, y_test = train_test_split(iris.data[:, :2], iris.target, random_state=42)

# Step 3: Bagging Classifier with KNN base estimator
from sklearn.ensemble import BaggingClassifier
from sklearn.neighbors import KNeighborsClassifier

classifier = BaggingClassifier(
    base_estimator=KNeighborsClassifier(),
    max_samples=10,
    n_estimators=100,
    random_state=42
)
classifier.fit(X_train, y_train)

print("\nBagging Classifier Accuracy:", classifier.score(X_test, y_test))

# Step 4: Standalone KNN for comparison
classifier_knn = KNeighborsClassifier()
classifier_knn.fit(X_train, y_train)
print("Single KNN Accuracy:", classifier_knn.score(X_test, y_test))

# Step 5: Visualization helpers
import numpy as np
import matplotlib.pyplot as plt

def make_meshgrid(x, y, h=.02):
    x_min, x_max = x.min() - 1, x.max() + 1
    y_min, y_max = y.min() - 1, y.max() + 1
    xx, yy = np.meshgrid(np.arange(x_min, x_max, h),
                         np.arange(y_min, y_max, h))
    return xx, yy

def plot_contours(ax, clf, xx, yy, **params):
    Z = clf.predict(np.c_[xx.ravel(), yy.ravel()])
    Z = Z.reshape(xx.shape)
    out = ax.contourf(xx, yy, Z, **params)
    return out

# Step 6: Plot decision boundaries
X0, X1 = iris.data[:, 0], iris.data[:, 1]
xx, yy = make_meshgrid(X0, X1)

plt.figure(figsize=(7,7))
plot_contours(plt, classifier, xx, yy, cmap=plt.cm.coolwarm, alpha=0.8)
plt.scatter(X0, X1, c=iris.target, cmap=plt.cm.coolwarm, s=20, edgecolors='k', alpha=0.6)
plt.title("Decision Boundary: Bagging Classifier with KNN")
plt.xlabel("Sepal length")
plt.ylabel("Sepal width")
plt.show()
